---
const { user } = Astro.locals;
---

<div
  class="mb-4 flex items-center justify-between gap-4 rounded-xl border border-emerald-400/15 bg-emerald-400/[0.04] px-4 py-3 text-sm text-emerald-100/80"
>
  {
    user ? (
      <>
        <div class="flex items-center gap-5">
          <a href="/library" class="flex items-center gap-2 transition-opacity hover:opacity-80">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-emerald-400 drop-shadow-[0_0_8px_rgba(52,211,153,0.6)]"
              aria-hidden="true"
            >
              <line x1="6" x2="10" y1="11" y2="11" />
              <line x1="8" x2="8" y1="9" y2="13" />
              <line x1="15" x2="15.01" y1="12" y2="12" />
              <line x1="18" x2="18.01" y1="10" y2="10" />
              <path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.544-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z" />
            </svg>
            <span class="text-sm font-semibold tracking-[0.2em] text-emerald-200/80 uppercase">Gaming Library</span>
          </a>
          <a
            href="/play-next"
            class="inline-flex items-center gap-1.5 font-medium text-emerald-200 transition-colors hover:text-emerald-100"
          >
            <span aria-hidden="true">▶</span>
            Play next
          </a>
        </div>
        <div class="flex items-center gap-3">
          <span class="hidden text-emerald-100/60 sm:inline">{user.email}</span>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-emerald-200/80 transition-colors hover:text-emerald-100 hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <a href="/" class="flex items-center gap-2 transition-opacity hover:opacity-80">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-emerald-400 drop-shadow-[0_0_8px_rgba(52,211,153,0.6)]"
            aria-hidden="true"
          >
            <line x1="6" x2="10" y1="11" y2="11" />
            <line x1="8" x2="8" y1="9" y2="13" />
            <line x1="15" x2="15.01" y1="12" y2="12" />
            <line x1="18" x2="18.01" y1="10" y2="10" />
            <path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.544-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z" />
          </svg>
          <span class="text-sm font-semibold tracking-[0.2em] text-emerald-200/80 uppercase">Gaming Library</span>
        </a>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-emerald-200/80 transition-colors hover:text-emerald-100 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-emerald-200/80 transition-colors hover:text-emerald-100 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
