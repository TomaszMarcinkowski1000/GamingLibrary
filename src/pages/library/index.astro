---
import type { LibraryEntry } from "@/types";
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listLibraryEntries, listUsedPlatforms } from "@/lib/services/library";
import { KNOWN_PLATFORMS } from "@/lib/platforms";
import GameDialog from "@/components/library/GameDialog";
import { EntryRowActions } from "@/components/library/EntryRowActions";
import PlayStatusControl from "@/components/library/PlayStatusControl";

const PAGE_SIZE = 20;

const pageParam = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const page = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1;

const rawQuery = Astro.url.searchParams.get("q") ?? "";
const query = rawQuery.trim();

const supabase = createClient(Astro.request.headers, Astro.cookies);

let entries: LibraryEntry[] = [];
let total = 0;
let usedPlatforms: string[] = [];
let loadError = false;

if (supabase) {
  try {
    // Platform options are a degradable nicety, so they resolve to [] on their own
    // failure — only a true entries-query failure should blank the library.
    const [list, platforms] = await Promise.all([
      listLibraryEntries(supabase, { page, pageSize: PAGE_SIZE, search: query || undefined }),
      listUsedPlatforms(supabase).catch(() => [] as string[]),
    ]);
    entries = list.entries;
    total = list.total;
    usedPlatforms = platforms;
  } catch {
    loadError = true;
  }
}

// Merge curated + already-used platforms, curated order first, case-insensitive dedupe.
const seen = new Set<string>();
const platformOptions: string[] = [];
for (const platform of [...KNOWN_PLATFORMS, ...usedPlatforms]) {
  const key = platform.toLowerCase();
  if (!seen.has(key)) {
    seen.add(key);
    platformOptions.push(platform);
  }
}

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

// Deleting the last row on a page can leave the reload targeting a now-out-of-bounds page
// (e.g. ?page=2 when only 1 page remains). Clamp to the last valid page and re-fetch its rows so
// the list never renders an empty beyond-bounds table. (A top-level `return Astro.redirect` would be
// cleaner UX but crashes the lint pass — an astro-eslint-parser × no-misused-promises bug.)
const effectivePage = Math.min(page, totalPages);
if (supabase && !loadError && effectivePage !== page) {
  try {
    const list = await listLibraryEntries(supabase, {
      page: effectivePage,
      pageSize: PAGE_SIZE,
      search: query || undefined,
    });
    entries = list.entries;
    total = list.total;
  } catch {
    loadError = true;
  }
}

const hasPrev = effectivePage > 1;
const hasNext = effectivePage < totalPages;
const isEmpty = total === 0 && !loadError && query.length === 0;
const noMatches = total === 0 && !loadError && query.length > 0;

function metadataLabel(entry: LibraryEntry): string | null {
  return entry.metadata_status === "matched" ? null : "No metadata";
}

// Build a page URL that preserves the current query params (e.g. `q`), only swapping `page`.
// S-06 extends this same seam to thread status/platform/genre/sort.
function pageHref(targetPage: number): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set("page", String(targetPage));
  return `/library?${params.toString()}`;
}
---

<Layout title="My Library">
  <main class="bg-cosmic min-h-screen px-4 py-10 text-white">
    <div class="mx-auto max-w-5xl">
      <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            My Library
          </h1>
          <p class="mt-1 text-sm text-blue-100/60">
            {total}
            {total === 1 ? "game" : "games"}
          </p>
        </div>
        {!isEmpty && <GameDialog platformOptions={platformOptions} client:load />}
      </header>

      {
        !isEmpty && !loadError && (
          <form method="get" action="/library" class="mb-6 flex flex-wrap items-center gap-3">
            <input
              type="text"
              name="q"
              value={query}
              placeholder="Search by title…"
              aria-label="Search your library by title"
              class="min-w-[12rem] flex-1 rounded-lg border border-white/20 bg-white/5 px-4 py-2 text-sm text-white backdrop-blur-xl placeholder:text-blue-100/40 focus:border-white/40 focus:outline-none"
            />
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
            >
              Search
            </button>
            {query.length > 0 && (
              <a
                href="/library"
                aria-label="Clear search"
                title="Clear search"
                class="inline-flex items-center justify-center rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-blue-100/80 transition-colors hover:bg-white/20 hover:text-white"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M18 6 6 18" />
                  <path d="m6 6 12 12" />
                </svg>
              </a>
            )}
          </form>
        )
      }

      {
        loadError && (
          <div class="rounded-xl border border-red-400/40 bg-red-500/10 p-4 text-sm text-red-200">
            Couldn’t load your library right now. Please refresh and try again.
          </div>
        )
      }

      {
        isEmpty && (
          <div class="flex flex-col items-center gap-4 rounded-2xl border border-white/10 bg-white/5 px-6 py-20 text-center backdrop-blur-xl">
            <h2 class="text-xl font-semibold text-white">Your library is empty</h2>
            <p class="max-w-sm text-sm text-blue-100/60">
              Add your first game to start cataloguing your collection — we’ll fetch its metadata for you.
            </p>
            <GameDialog
              platformOptions={platformOptions}
              triggerLabel="Add your first game"
              triggerSize="lg"
              client:load
            />
          </div>
        )
      }

      {
        noMatches && (
          <div class="flex flex-col items-center gap-4 rounded-2xl border border-white/10 bg-white/5 px-6 py-20 text-center backdrop-blur-xl">
            <h2 class="text-xl font-semibold text-white">No games match “{query}”</h2>
            <p class="max-w-sm text-sm text-blue-100/60">
              Try a different title fragment, or clear the search to see your whole library.
            </p>
            <a
              href="/library"
              class="rounded-lg border border-white/20 bg-white/10 px-5 py-2 text-sm transition-colors hover:bg-white/20"
            >
              Clear search
            </a>
          </div>
        )
      }

      {
        !isEmpty && !loadError && (
          <>
            <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl">
              <table class="w-full text-left text-sm">
                <thead class="border-b border-white/10 text-xs tracking-wide text-blue-100/50 uppercase">
                  <tr>
                    <th class="px-4 py-3 font-medium">Title</th>
                    <th class="px-4 py-3 font-medium">Platform</th>
                    <th class="px-4 py-3 font-medium">Status</th>
                    <th class="px-4 py-3 font-medium">Genre</th>
                    <th class="px-4 py-3 font-medium">Year</th>
                    <th class="px-4 py-3 text-right font-medium">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {entries.map((entry) => {
                    const noMeta = metadataLabel(entry);
                    return (
                      <tr class="border-b border-white/5 last:border-0">
                        <td class="px-4 py-3">
                          <span class="font-medium text-white">{entry.title}</span>
                          {noMeta && (
                            <span class="ml-2 rounded-full bg-amber-500/15 px-2 py-0.5 text-xs text-amber-200">
                              {noMeta}
                            </span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-blue-100/80">{entry.platform}</td>
                        <td class="px-4 py-3">
                          <PlayStatusControl entry={entry} client:visible />
                        </td>
                        <td class="px-4 py-3 text-blue-100/60">{entry.genre?.length ? entry.genre.join(", ") : "—"}</td>
                        <td class="px-4 py-3 text-blue-100/60">{entry.release_year ?? "—"}</td>
                        <td class="px-4 py-3">
                          <EntryRowActions entry={entry} platformOptions={platformOptions} client:visible />
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            <nav class="mt-6 flex items-center justify-between text-sm" aria-label="Pagination">
              {hasPrev ? (
                <a
                  href={pageHref(effectivePage - 1)}
                  class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 transition-colors hover:bg-white/20"
                >
                  ← Previous
                </a>
              ) : (
                <span
                  aria-disabled="true"
                  class="cursor-not-allowed rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-white/30"
                >
                  ← Previous
                </span>
              )}

              <span class="text-blue-100/60">
                Page {effectivePage} of {totalPages}
              </span>

              {hasNext ? (
                <a
                  href={pageHref(effectivePage + 1)}
                  class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 transition-colors hover:bg-white/20"
                >
                  Next →
                </a>
              ) : (
                <span
                  aria-disabled="true"
                  class="cursor-not-allowed rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-white/30"
                >
                  Next →
                </span>
              )}
            </nav>
          </>
        )
      }
    </div>
  </main>
</Layout>
