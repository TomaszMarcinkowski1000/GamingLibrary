---
import Layout from "./Layout.astro";

interface Props {
  title?: string;
  /**
   * How much of the landing's neon treatment to render.
   * - "full": the landing look — neon grid floor + both accent glows (verbatim from Welcome).
   * - "calm": green-black base with the grid dropped and only faint glows (app pages).
   */
  decoration?: "full" | "calm";
}

const { title, decoration = "calm" } = Astro.props;
const year = new Date().getFullYear();
---

<Layout title={title}>
  <div class="relative min-h-screen w-full overflow-hidden bg-[#070b09] text-emerald-50">
    {
      decoration === "full" && (
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.18]"
          style="background-image: linear-gradient(rgba(16,185,129,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(16,185,129,0.4) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 80%);"
        />
      )
    }
    {/* Accent glows: full keeps the landing's strength; calm renders them fainter. */}
    <div
      class:list={[
        "pointer-events-none absolute -top-24 left-1/3 h-[360px] w-[360px] rounded-full blur-[130px]",
        decoration === "full" ? "bg-emerald-500/20" : "bg-emerald-500/10",
      ]}
    >
    </div>
    <div
      class:list={[
        "pointer-events-none absolute top-1/2 -right-20 h-[300px] w-[300px] rounded-full blur-[120px]",
        decoration === "full" ? "bg-cyan-400/15" : "bg-cyan-400/[0.08]",
      ]}
    >
    </div>

    <div class="relative z-10 flex min-h-screen flex-col">
      <div class="flex flex-1 flex-col">
        <slot />
      </div>
      <footer class="border-t border-emerald-400/10 py-6 text-center text-xs text-emerald-100/40">
        <div class="mx-auto max-w-[1400px] px-4">Gaming Library — a home for one collector's shelf. © {year}</div>
      </footer>
    </div>
  </div>
</Layout>
