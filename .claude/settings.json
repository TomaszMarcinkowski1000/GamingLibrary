{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm view *)",
      "Bash(gh run watch *)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/eslint-changed.mjs",
            "timeout": 30,
            "statusMessage": "ESLint on edited file"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/test-related-changed.mjs",
            "timeout": 60,
            "statusMessage": "Vitest related (risk area)"
          }
        ]
      }
    ]
  }
}
