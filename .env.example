SUPABASE_URL=###
SUPABASE_KEY=###

# Vision provider for the photo-identification spike (F-03). Server-only secret.
# Create a key at https://openrouter.ai/keys. Local dev goes in .dev.vars; prod via
# `wrangler secret put OPENROUTER_API_KEY`. Optional in the env schema — builds/CI
# proceed without it; the vision service throws loudly only at call time.
OPENROUTER_API_KEY=###

# Playwright e2e account. A confirmed user in the LOCAL Supabase instance — the specs sign in
# through the real /api/auth/signin route (see e2e/auth.setup.ts), so this is not a mock.
# Never point it at a production account: the suite creates and deletes library rows.
# Create one with: npx supabase start, then sign up at http://localhost:4321/auth/signup
# (Mailpit at http://127.0.0.1:54324 catches the confirmation mail).
E2E_EMAIL=###
E2E_PASSWORD=###