{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gaming-library",
  // Not a stray file: the wrapper re-exports `@astrojs/cloudflare/entrypoints/server` (the former
  // value of this field) wrapped in `Sentry.withSentry`, so unhandled throws reach Sentry.
  "main": "./sentry.server.config.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  // Emit source maps for the deployed Worker bundle so Sentry stack traces point at real `src/`
  // lines instead of minified output. The maps are uploaded to Cloudflare, not served to clients.
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "IGDB_TOKENS",
      "id": "62fa277391214ef5889b1d29c048196e",
      "preview_id": "1a7f6e20d9ed4ac6a1c5fa0a7b9d6581",
    },
  ],
}
